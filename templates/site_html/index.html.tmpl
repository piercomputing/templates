<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{{.SiteName}}</title>
    <style>
      body {
        font-family: system-ui, sans-serif;
        max-width: 640px;
        margin: 4rem auto;
        padding: 0 1rem;
        color: #1a1a1a;
      }
      h1 {
        color: #2563eb;
      }
      code {
        background: #f1f5f9;
        padding: 0.2em 0.4em;
        border-radius: 4px;
        font-size: 0.9em;
      }
    </style>
  </head>
  <body>
    <h1>{{.SiteName}}</h1>
    <p>
      This is a plain HTML static site deployed with
      <code>pier sites deploy</code>.
    </p>
    <p>No build step required.</p>
  </body>
</html>
